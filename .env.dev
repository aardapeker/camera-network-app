# Development Environment Variables
# Copy this to .env for local development with Docker

# Database
POSTGRES_DB=fielddesk_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword

# Mail (optional for dev)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT signing secret (has a fixed dev-only fallback in compose.dev.yml if unset,
# so restarting the backend doesn't invalidate logged-in sessions)
JWT_SECRET=

# API key the Raspberry Pi's scan.py must send as the X-API-Key header
# (has a fixed dev-only fallback in compose.dev.yml if unset)
SCAN_API_KEY=

# URLs (automatically set for development)
FILE_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173

# OpenAI (Whisper speech-to-text) - fill in via .env, never commit a real key here
OPENAI_API_KEY=

# AWS S3 Backup (fill in your credentials for local dev testing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fielddesk-backups
AWS_S3_REGION=eu-north-1
