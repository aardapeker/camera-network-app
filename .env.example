# Required
POSTGRES_PASSWORD=your_secure_password_here

# Public domains Caddy serves (and gets TLS certificates for)
APP_DOMAIN=app.example.com
PORTAL_DOMAIN=servisform.example.com
# Origins the backend accepts cross-origin requests from (comma-separated)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://servisform.example.com

# Password for the bootstrap 'root' admin, used only on the first start against an
# empty database. Leave empty and a random one is generated and printed to the
# backend log once. Change it after your first login either way.
ADMIN_INITIAL_PASSWORD=
# SMTP login. On the company mail server this is the mailbox itself; some hosts
# want the full address, others only the part before the @.
MAIL_USERNAME=servisform@your-domain.com
MAIL_PASSWORD=that_mailbox_password

# The address recipients see. Must be a domain your SMTP server is allowed to
# send for, or DMARC will send the mail to spam.
MAIL_FROM=servisform@your-domain.com
MAIL_FROM_NAME=Your Company

# JWT signing secret - MUST be set and MUST stay the same across deploys,
# otherwise every restart invalidates all tokens and logs everyone out.
# Generate once with: openssl rand -base64 32
JWT_SECRET=your_base64_jwt_secret_here

# URLs (change for production)
FILE_BASE_URL=https://your-domain.com
FRONTEND_BASE_URL=https://your-domain.com


# OpenAI (Whisper speech-to-text)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Network scan ingestion - long random secret shared with the Raspberry Pi's
# scan.py (sent as the X-API-Key header). Generate with e.g. `openssl rand -hex 32`.
SCAN_API_KEY=your_long_random_scan_key_here

# AWS S3 Backup
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET=fielddesk-backups
AWS_S3_REGION=eu-north-1

# Optional (uncomment to override defaults)
# Defaults target Gmail (smtp.gmail.com:587, STARTTLS). Point these at the
# company mail server instead; port 465 needs MAIL_SSL=true and MAIL_STARTTLS=false.
# MAIL_HOST=mail.your-domain.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_SSL=false
# Logs the whole SMTP conversation - turn on if a send fails.
# MAIL_DEBUG=false
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# AWS_S3_KEEP_LAST=30
# PGDUMP_PATH=pg_dump