# Domains come from .env (APP_DOMAIN, PORTAL_DOMAIN). Caddy gets TLS certificates
# for them automatically.
{$APP_DOMAIN} {
    request_body {
        max_size 50MB
    }
    reverse_proxy frontend:80
}

# Technician service-form portal. Same SPA build as the main site - the app
# recognises any hostname starting with "servisform." and shows only sign-in +
# service forms.
{$PORTAL_DOMAIN} {
    request_body {
        max_size 50MB
    }
    reverse_proxy frontend:80
}
