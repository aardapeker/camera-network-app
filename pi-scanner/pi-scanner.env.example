# Copy this to /etc/pi-scanner.env on the Pi and fill in real values.
# This file contains a secret - keep its permissions locked down (chmod 600).

# Backend base URL the Pi can reach. On your LAN during dev this is your
# PC's IP and the exposed backend port, e.g. http://192.168.2.25:8080
BACKEND_URL=http://192.168.2.25:8080

# Must match the backend's SCAN_API_KEY exactly (see .env / compose.dev.yml
# on the backend side). Use a long random value in production
# (e.g. `openssl rand -hex 32`); the dev default is fine for local testing.
API_KEY=dev-only-pi-scanner-key-change-me

# Get this from `ip route` on the Pi itself - don't assume it matches
# whatever network you're on right now. Comma-separated for a site with
# multiple IP blocks/VLANs - all blocks are scanned together in one nmap
# pass, e.g. SUBNET=192.168.1.0/24,192.168.2.0/24,10.0.5.0/24
SUBNET=192.168.2.0/24

SOURCE_ID=pi-scanner

# How often to scan and report, in seconds. A /24 scan takes ~9s; more
# blocks means a longer scan (nmap probes every address in each block
# regardless of how many respond). If journalctl shows the "cycle took
# longer than INTERVAL_SECONDS" warning, raise this value - aim for at
# least 2-3x your actual measured scan time.
INTERVAL_SECONDS=60
