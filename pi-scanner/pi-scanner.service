[Unit]
Description=Periodic nmap scan reporter for the FieldDesk backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/pi-scanner.env
ExecStart=/usr/bin/python3 /opt/pi-scanner/scan.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
